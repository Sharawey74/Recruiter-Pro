# Recruiter-Pro — environment configuration
#
# Copy to .env and fill in. .env is gitignored and must stay that way:
# nothing in this file should ever carry a real value.
#
#     cp .env.example .env
#
# Every variable is optional. Anything unset falls back to config/agents.yaml,
# then to the dataclass defaults in src/core/config.py.

# ── Environment ──────────────────────────────────────────────────────────────
ENV=development
DEBUG=false

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# Comma-separated allowlist. This is a real security control, not a formality:
# it is what the browser checks before letting the frontend read a response.
# Set it to the deployed frontend origin in production. Do not use "*" -- the
# CORS spec forbids "*" with credentials, so browsers reject the response.
CORS_ORIGINS=http://localhost:3000

# Per-IP rate limits on the endpoints that do real work. These protect the
# instance from abuse; they are not what protects the LLM quota (see below).
# Set RATE_LIMIT_ENABLED=false only for local load testing.
RATE_LIMIT_ENABLED=true
MATCH_RATE_LIMIT=5/minute
UPLOAD_RATE_LIMIT=10/minute

# Believe X-Forwarded-For when identifying a client for rate limiting.
#
# Off by default, and both defaults matter. Behind a proxy (Railway, Fly, a load
# balancer) the socket address is the proxy's, so every visitor shares one
# bucket and ordinary traffic collects 429s. With nothing in front, trusting the
# header lets any client invent an address per request and evade the limit
# entirely. Set true ONLY where something in front actually sets it.
TRUST_PROXY_HEADERS=false

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_TYPE=sqlite
DATABASE_PATH=data/database/match_history.db

# Only when DATABASE_TYPE=mysql.
# MYSQL_HOST=
# MYSQL_USER=
# MYSQL_PASSWORD=
# MYSQL_DATABASE=

# ── LLM (Agent 4 explanations) ───────────────────────────────────────────────
LLM_ENABLED=true
LLM_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://localhost:11500

# Which explanation provider to use. See ADR-2.
#   ollama       local development (default); needs Ollama running locally
#   openrouter   hosted demo; requires OPENROUTER_API_KEY below
#   rule_based   offline and CI; also the fallback for all of the above
LLM_PROVIDER=ollama

# Daily LLM call budget for the whole instance, counted in SQLite so it
# survives a restart. At LLM_QUOTA_DEGRADE_AT of the quota, explanations switch
# to rule-based for the rest of the day: running out degrades the demo instead
# of breaking it. 0 disables the counter.
LLM_DAILY_QUOTA=200
LLM_QUOTA_DEGRADE_AT=0.90

# Concurrent calls allowed to the provider. Free tiers answer excess
# concurrency with 429s rather than a queue.
LLM_MAX_CONCURRENT_CALLS=2

# ── Secrets ──────────────────────────────────────────────────────────────────
# Read from the environment only. Never commit a real key, never log one, and
# never return one in an API response. Used by
# src/agents/explaining/openrouter.py when LLM_PROVIDER=openrouter; without it
# that provider reports unavailable and explanations fall back to rule-based.
# OPENROUTER_API_KEY=

# Optional: override the default free model. The default is chosen for this
# workload -- short, factual, latency-sensitive prose, three calls per upload --
# and is the fastest of the free tier at roughly 3.9s per explanation. See the
# comment above DEFAULT_MODEL in src/agents/explaining/openrouter.py for how the
# alternatives compare.
#
#   nvidia/nemotron-3-nano-30b-a3b:free   default; fastest
#   google/gemma-4-31b-it:free            slower, but the strongest writer here
#
# OPENROUTER_MODEL=nvidia/nemotron-3-nano-30b-a3b:free
