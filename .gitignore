*.sublime-workspace
*~

# ====================
# Operating System
# ====================
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ====================
# Environment Variables
# ====================
.env
.env.local
.env.*.local

# .env.example is deliberately NOT ignored. It carries the variable names with
# no values, and it is the only place a new contributor can discover what the
# application reads from the environment. It was listed here, which is why the
# file never existed.

# ====================
# Test artifacts
# ====================
# Plots written directly into models/experiments/ by a test run. Two of these
# were committed by accident. Tests now write to tmp_path, so anything landing
# here again came from a real training run in a dated subdirectory -- which
# stays tracked.
models/experiments/*.png

# ====================
# Logs
# ====================
*.log
logs/
*.log.*

# ====================
# Distribution & Packaging
# ====================
dist/
build/
*.egg-info/
*.egg
.eggs/

# ====================
# Cache Directories
# ====================
.cache/
.mypy_cache/
.dmypy.json
dmypy.json

# ====================
# Model Files
# ====================
models/*.pkl
models/*.joblib
models/*.pt
models/*.pth
models/*.onnx
*.pkl
*.joblib

# The two production artifacts are the exception: without them ATSPredictor
# returns False, Agent 3 falls back to rule-based, and the hybrid ML scoring
# this project advertises does not run at all for anyone who clones it.
# They are a logistic regression plus a feature encoder — small enough to
# track, and the repo is not useful without them.
#
# Listed by name rather than as `!models/production/*.joblib`. Both forms work
# (the rules above match files, not the directory, so the negation is not
# inert the way the docs/ one was). The explicit list is an allowlist: a stray
# experiment artifact dropped into models/production/ stays ignored instead of
# being committed by accident.
!models/production/ats_model.joblib
!models/production/feature_engineer.joblib

